# ==========================================
# Cinematic Portfolio & Admin Studio
# Environment Variables Configuration
# ==========================================

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# NextAuth.js Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_super_secret_string_here_for_nextauth
NEXTAUTH_URL=http://localhost:3000

# Primary Administrator Email (Restricts OAuth and credentials access)
ADMIN_EMAIL=zakaria.binmoti@gmail.com

# Google OAuth Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your live domain)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Cloudinary Media Management (Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Delivery (Used for secure 6-digit OTP password reset)
# In local development without SMTP, OTP will safely print to terminal stdout
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Zakaria Portfolio" <your_email@gmail.com>
